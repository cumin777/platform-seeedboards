 * SPDX-License-Identifier: Apache-2.0
 *
 * XIAO 14-pin connector GPIO mapping for STM32C5.
 * Pin assignments follow nucleo_c5a3zg reference for initial bring-up.
 * PLACEHOLDER - update with actual XIAO C5 pin map when available.
 */

/ {
	xiao_d: connector {
		compatible = "seeed,xiao-gpio";
		#gpio-cells = <2>;
		gpio-map-mask = <0xffffffff 0xffffffc0>;
		gpio-map-pass-thru = <0 0x3f>;
		gpio-map = <0 0 &gpioa 0 0>,    /* D0 - PLACEHOLDER */
			   <1 0 &gpioa 1 0>,    /* D1 - PLACEHOLDER */
			   <2 0 &gpioa 2 0>,    /* D2 - PLACEHOLDER */
			   <3 0 &gpioa 3 0>,    /* D3 - PLACEHOLDER */
			   <4 0 &gpioa 4 0>,    /* D4 - PLACEHOLDER */
			   <5 0 &gpioa 5 0>,    /* D5 - PLACEHOLDER */
			   <6 0 &gpioa 6 0>,    /* D6 - PLACEHOLDER */
			   <7 0 &gpioa 7 0>,    /* D7 - PLACEHOLDER */
			   <8 0 &gpioa 8 0>,    /* D8 - PLACEHOLDER */
			   <9 0 &gpioa 9 0>,    /* D9 - PLACEHOLDER */
			   <10 0 &gpioa 10 0>,  /* D10 - PLACEHOLDER */
			   <11 0 &gpioa 11 0>,  /* D11 - PLACEHOLDER */
			   <12 0 &gpiob 0 0>,   /* D12 - PLACEHOLDER */
			   <13 0 &gpiob 1 0>,   /* D13 - PLACEHOLDER */
			   <14 0 &gpiob 2 0>,   /* D14 - PLACEHOLDER */
			   <15 0 &gpiob 3 0>;   /* D15 - PLACEHOLDER */
	};
};

/* PLACEHOLDER aliases - update when pin map is finalized */
xiao_serial: &lpuart1 {};
