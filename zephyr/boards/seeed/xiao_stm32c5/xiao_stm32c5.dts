 *
 * XIAO STM32C5 board definition.
 * Pin map follows nucleo_c5a3zg reference configuration for initial bring-up.
 */

/dts-v1/;
#include <st/c5/stm32c5a3Xg.dtsi>
#include <st/c5/stm32c5(9-a)3z(e-g)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "seeed_xiao_connector.dtsi"

/ {
	model = "Seeed XIAO STM32C5";
	compatible = "seeed,xiao-stm32c5";

	chosen {
		zephyr,console = &lpuart1;
		zephyr,shell-uart = &lpuart1;
		zephyr,sram = &sram1;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};

	aliases {
		led0 = &green_led;
		sw0 = &user_button;
		watchdog0 = &iwdg;
	};

	gpio_keys {
		compatible = "gpio-keys";

		user_button: button {
			label = "USER";
			gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds: leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioa 5 GPIO_ACTIVE_HIGH>;
			label = "LD1";
		};
	};
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(48)>;
	status = "okay";
};

&clk_hsidiv3 {
	status = "okay";
};

&clk_hsis {
	status = "okay";
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		/* TinyUF2 Bootloader: 32KB */
		boot_partition: partition@0 {
			label = "uf2-bootloader";
			reg = <0x00000000 DT_SIZE_K(32)>;
		};

		/* Application slot: 488KB (aligned with UF2 layout) */
		slot0_partition: partition@8000 {
			label = "image-0";
			reg = <0x00008000 DT_SIZE_K(488)>;
		};

		/* OTA slot: 480KB */
		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 DT_SIZE_K(480)>;
		};

		/* Storage: 24KB */
		storage_partition: partition@fa000 {
			label = "storage";
			reg = <0x000fa000 DT_SIZE_K(24)>;
		};
	};
};

&lpuart1 {
	pinctrl-0 = <&lpuart1_tx_pa3 &lpuart1_rx_pa2>;
	pinctrl-names = "default";
	current-speed = <115200>;
	status = "okay";
};

&rcc {
	clocks = <&clk_hsis>;
	clock-frequency = <DT_FREQ_M(144)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <2>;
	apb2-prescaler = <2>;
	apb3-prescaler = <2>;
};

&iwdg {
	status = "okay";
};
