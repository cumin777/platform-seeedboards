# Zephyr engine patch 5/5: XIAO-provisioned module discovery
# Host function: run_cmake()
# Why: XIAO modules (xiao_dfu_reset, sdk-edge-ai, edge-impulse-sdk-zephyr)
#   are provisioned by this platform into _pio/modules, not by a user's west
#   manifest; stock cmake_cmd never registers them. Also honors
#   XIAO_EDGE_AI_DIR / XIAO_EDGE_IMPULSE_DIR developer overrides.
# Upstream: none (PlatformIO framework-zephyr package scripts).
# Exit: superseded when module registration moves fully to the
#   ZEPHYR_EXTRA_MODULES environment channel (incl. sysbuild propagation).
--- a/scripts/platformio/platformio-build.py
+++ b/scripts/platformio/platformio-build.py
@@ -241,6 +241,31 @@
                 )
             )
         )
+
+    # Auto-add XIAO-provisioned Zephyr modules. These are not in a
+    # project's west manifest, so discover them from the framework cache.
+    for _xiao_module in ("xiao_dfu_reset", "sdk-edge-ai",
+                         "edge-impulse-sdk-zephyr"):
+        _xiao_module_dir = os.path.join(
+            FRAMEWORK_DIR, "_pio", "modules", _xiao_module)
+        if os.path.isfile(os.path.join(_xiao_module_dir, "zephyr", "module.yml")):
+            _mod_unix = fs.to_unix_path(_xiao_module_dir)
+            if not any(os.path.normcase(os.path.normpath(module)) ==
+                       os.path.normcase(os.path.normpath(_xiao_module_dir))
+                       for module in modules):
+                modules.append(_mod_unix)
+
+    # Honor explicit Edge AI module overrides. The SCons environment
+    # is not inherited by this standalone build helper, whereas these
+    # variables are exported for CI and local developer builds.
+    for _xiao_override in ("XIAO_EDGE_AI_DIR", "XIAO_EDGE_IMPULSE_DIR"):
+        _xiao_module_dir = os.environ.get(_xiao_override, "")
+        if os.path.isfile(os.path.join(_xiao_module_dir, "zephyr", "module.yml")):
+            _mod_unix = fs.to_unix_path(_xiao_module_dir)
+            if not any(os.path.normcase(os.path.normpath(module)) ==
+                       os.path.normcase(os.path.normpath(_xiao_module_dir))
+                       for module in modules):
+                modules.append(_mod_unix)
 
     cmake_cmd.extend(["-D", "ZEPHYR_MODULES=" + ";".join(modules)])
 
